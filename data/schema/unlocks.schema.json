{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daevacompanion.com/schema/v2/unlocks.schema.json",
  "title": "Content unlocks (packs/<game>/<faction>/unlocks.json)",
  "description": "DRAFT. Informational (not tickable). Replaces VERIFIED_UNLOCKS, build.json unlocks / dailyDungeon / unlocksRecommendation. The 'Ahead' row shows records whose status is verified.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "collection": {
      "const": "unlocks"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unlock"
      }
    }
  },
  "$defs": {
    "unlock": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/provenance"
        }
      ],
      "required": [
        "id",
        "what",
        "at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^unlock:[a-z0-9-]+$"
        },
        "what": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "detail": {
          "type": "string",
          "maxLength": 200
        },
        "at": {
          "description": "When it opens.",
          "$ref": "common.schema.json#/$defs/cond"
        },
        "hotkey": {
          "description": "The feature's default key, as the owner's unlock screen shows it (0.6 P14). ref names that screen; it must be one of the record's owner sources, and that source's `what` must show the key in brackets (tools/gen/gen.mjs checks both). Only a record for one feature with one key has it.",
          "type": "object",
          "required": [
            "key",
            "ref"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^(Alt\\+)?[A-Z]$"
            },
            "ref": {
              "type": "string",
              "pattern": "^owner:[0-9]{4}-[0-9]{2}-[0-9]{2}-unlocks-[0-9]{2}$"
            }
          },
          "additionalProperties": false
        },
        "party": {
          "type": "string",
          "maxLength": 20
        },
        "timeLimit": {
          "type": "string",
          "maxLength": 60
        },
        "conquest": {
          "type": "object",
          "properties": {
            "lv": {
              "type": "integer"
            },
            "itemLevel": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "storyStep": {
          "type": "string",
          "maxLength": 300
        },
        "otherNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entries": {
          "type": "string",
          "maxLength": 300
        },
        "credit": {
          "description": "Sites credited on the Ahead row, as the app shows them (VERIFIED_UNLOCKS 4th column). Only records with a credit are listed as verified unlocks.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "order": {
          "description": "Display order among the credited unlocks (records are stored sorted by id).",
          "type": "number"
        }
      },
      "unevaluatedProperties": false
    }
  },
  "type": "object"
}
