{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daevacompanion.com/schema/v2/builds.schema.json",
  "title": "Builds (packs/<game>/<faction>/<class>/builds.json)",
  "description": "DRAFT (M1, owner decision 2026-10-14). Build choices, split from game facts. Per class: one guide build (origin guide, the class's defaultBuild) and up to two credited alternatives (origin community), each credited to the sites it came from; choices only, never their wording. A build needs two agreeing sources or it is 'single-source'. Every reference is a record id the build checks. 5b compiles the default build into today's SP_SKILLS / STIGMA_PLAN / ST_TARGETS / STAT_TIERS / STAT_SRC / RMB_STACK / E_ORDER and the dv plan items.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "collection": {
      "const": "builds"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/build"
      },
      "minItems": 1,
      "maxItems": 3
    }
  },
  "$defs": {
    "planNode": {
      "description": "A board node the build buys, placed in a milestone like today's dv items. Its save key is the node's key (boardNodes).",
      "type": "object",
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/stepFields"
        }
      ],
      "required": [
        "milestone",
        "order"
      ],
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^node:[a-z]+:[a-z0-9-]+:r[0-9]+c[0-9]+$"
        },
        "key": {
          "description": "Only for an anyOf entry: its legacy save key.",
          "type": "string",
          "pattern": "^dv:([zvt]:)?[a-z0-9]+$"
        },
        "label": {
          "type": "string"
        },
        "via": {
          "type": "string"
        },
        "cost": {
          "description": "Points this row takes in the guide's order, its path included (the owner's board, cited with fields [\"cost\"]): what the Daevanion card's cost box pre-fills. A cost computed from the path instead cites an inferred source with fields [\"cost\"] and carries fieldStatus { cost: inferred } (0.9 P16). The generator checks it against the cheapest path (tools/gen/board-path.mjs).",
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "milestone": {
          "type": "string",
          "pattern": "^g[0-9]+$"
        },
        "order": {
          "type": "number"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/status"
        },
        "fieldStatus": {
          "description": "Per-field verdict where it differs from the row's status: { \"cost\": \"inferred\" } for a cost computed from the board path (0.9 P16), not read from the game. The Daevanion card tags the cost box.",
          "type": "object",
          "propertyNames": {
            "enum": [
              "cost"
            ]
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/status"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/sourceRef"
          }
        },
        "anyNode": {
          "description": "Legacy 'any one of these' plan keys (dv:corner = any Nezekan corner).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^node:[a-z]+:[a-z0-9-]+:r[0-9]+c[0-9]+$"
          },
          "minItems": 2
        }
      },
      "unevaluatedProperties": false,
      "oneOf": [
        {
          "required": [
            "node"
          ],
          "not": {
            "required": [
              "anyNode"
            ],
            "type": "object",
            "properties": {
              "anyNode": true
            }
          },
          "type": "object",
          "properties": {
            "node": true
          }
        },
        {
          "required": [
            "anyNode",
            "key"
          ],
          "not": {
            "required": [
              "node"
            ],
            "type": "object",
            "properties": {
              "node": true
            }
          },
          "type": "object",
          "properties": {
            "anyNode": true,
            "key": true
          }
        }
      ]
    },
    "build": {
      "type": "object",
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/provenance"
        }
      ],
      "required": [
        "id",
        "class",
        "name",
        "origin",
        "skillOrder",
        "stigmaSlots"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^build:[a-z]+:[a-z0-9-]+$"
        },
        "class": {
          "$ref": "common.schema.json#/$defs/classId"
        },
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "origin": {
          "description": "guide = the guide's own build; community = an alternative credited to its source sites.",
          "enum": [
            "guide",
            "community"
          ]
        },
        "statPriority": {
          "type": "object",
          "properties": {
            "tiers": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "from": {
              "description": "B = board, G = gear.",
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "B",
                  "G",
                  "BG"
                ]
              }
            },
            "status": {
              "$ref": "common.schema.json#/$defs/status"
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/sourceRef"
              },
              "minItems": 1
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "tiers",
            "status",
            "sources"
          ],
          "additionalProperties": false
        },
        "skillOrder": {
          "description": "Skill-point order (core, then extras). A skill is 'in the plan' (today's tracked) iff it appears here.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "skill",
              "status"
            ],
            "properties": {
              "skill": {
                "type": "string",
                "pattern": "^skill:[a-z]+:[a-z0-9-]+$"
              },
              "core": {
                "type": "boolean"
              },
              "status": {
                "$ref": "common.schema.json#/$defs/status"
              },
              "basis": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/sourceRef"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "skillOrderNotes": {
          "type": "object",
          "properties": {
            "skip": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "interleave": {
              "type": "string"
            },
            "budget": {
              "type": "string"
            },
            "notFetched": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "specialtyPicks": {
          "description": "Per skill, the choices for slots 1..3 in order (choice ids, M4).",
          "type": "object",
          "propertyNames": {
            "pattern": "^skill:[a-z]+:[a-z0-9-]+$",
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^spec:[a-z]+:[a-z0-9-]+:[1-9]$"
            },
            "maxItems": 3
          }
        },
        "specialtyEvidence": {
          "description": "Allow-list for specialty picks beyond slot 1 (0.3 E7): per choice id, the slot it fills, its evidence label and the slot witnesses (build source URLs). The generator rejects a slot 2 / 3 pick without an entry here: '2+ sources' (two or more publishers) or a labelled pick (disputed / contested / inferred, with a note; 0.8.1 F2).",
          "type": "object",
          "propertyNames": {
            "pattern": "^spec:[a-z]+:[a-z0-9-]+:[1-9]$",
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "slot",
              "label",
              "sources"
            ],
            "properties": {
              "slot": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "label": {
                "description": "'2+ sources': two or more publishers place the pick in this slot. disputed / contested / inferred / single source (0.8.1 F2, owner note 5: every slot 2 gets a pick; 0.9 P15: a slot 1 pick may carry its own label too): a labelled pick, shown with its label; it needs a 'note' naming the alternative.",
                "enum": [
                  "2+ sources",
                  "disputed",
                  "contested",
                  "inferred",
                  "single source"
                ]
              },
              "note": {
                "description": "A labelled pick's reason and the alternative it was weighed against (the specialty row's tooltip).",
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/httpsUrl"
                },
                "minItems": 1
              },
              "owner": {
                "description": "Owner screens that witness the choice in game (its text and unlock level). They back the choice, not the slot order: the '2+ sources' label still rests on the slot witnesses in 'sources'.",
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/ownerRef"
                },
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "noPick": {
          "description": "Choice points the build leaves without a pick (0.9 P15, docs/research/2026-10-choice-points.md), each with its reason. The generator lists every choice point in reach (specialty slots of core actives the plan's skill points and board nodes reach, stigma slots) and fails on one with neither a pick nor an entry here, and on an entry for a point that has a pick or is out of reach. Key: '<skill id>#<slot>' or 'stigma#<slot>'.",
          "type": "object",
          "propertyNames": {
            "pattern": "^(skill:[a-z]+:[a-z0-9-]+|stigma)#[1-9]$",
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "reason",
              "note"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "no-source",
                  "disputed-left-out"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "stigmaSlots": {
          "description": "Stigma per slot (today STIGMA_PLAN).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^stigma:[a-z]+:[a-z0-9-]+$"
          }
        },
        "stigmaTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stigma",
              "level"
            ],
            "properties": {
              "stigma": {
                "type": "string",
                "pattern": "^stigma:[a-z]+:[a-z0-9-]+$"
              },
              "level": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "stigmaSpecialtyPicks": {
          "type": "object",
          "propertyNames": {
            "pattern": "^stigma:[a-z]+:[a-z0-9-]+$",
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^spec:[a-z]+:[a-z0-9-]+:[1-9]$"
            }
          }
        },
        "boardPlan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/planNode"
          }
        },
        "keyStacks": {
          "type": "object",
          "properties": {
            "slots": {
              "description": "The guide's suggested stacks, one per skill quickslot (the game's 12, 'Skill Quickslot: Quick Use 1' to 'Quick Use 12'; owner screens, T-106, 2026-10-21), each a stack by character level: a row shows from its minLv, the highest minLv the level reaches wins. Default keys (rebindable, each with a second key; T-106): Quick Use 1 = Left click / R, 2 = Right click / T, 3-6 = 1-4, 7 = Q, 8 = E, 9-12 = 5-8. So T and R are second keys, not slots of their own. Each skills array is row 0 first, the row that fires first (claim C21); the game draws row 0 at the bottom, which is drawing only, so never reorder the array to match the screen. A quickslot holds at most 4 skills (rows 0-3; C21, owner T-106); Quick Use 1 (left click, the basic attack) holds row 0 only (owner 14:07Z and T-106 screen). A stigma may sit in a quickslot like a skill (owner, T-104 and 22:32Z); a skill or stigma sits in one quickslot at a time, never two (owner, 22:32Z; generator check per level). Quick Use 1 is reserved for the base attack (owner, 22:32Z). Guide advice (label on keyStacks.status), separate from defaultKeys, the game's own defaults.",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "slot",
                  "rows"
                ],
                "properties": {
                  "slot": {
                    "enum": [
                      "Quick Use 1",
                      "Quick Use 2",
                      "Quick Use 3",
                      "Quick Use 4",
                      "Quick Use 5",
                      "Quick Use 6",
                      "Quick Use 7",
                      "Quick Use 8",
                      "Quick Use 9",
                      "Quick Use 10",
                      "Quick Use 11",
                      "Quick Use 12"
                    ]
                  },
                  "rows": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "minLv",
                        "skills"
                      ],
                      "properties": {
                        "minLv": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "skills": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 4,
                          "items": {
                            "type": "string",
                            "pattern": "^(skill|stigma):[a-z]+:[a-z0-9-]+$"
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "macros": {
              "description": "The guide's suggested macros. A macro sits on a quickslot with a 0-3 stack (Quick Use 2-12; that it can sit on any of them, not only right click, Q and E, applies the owner's rule 'any key with a full 0-3 row can have a macro' to the T-106 skill bar: inferred), never Quick Use 1 (left click). A class can have several, one per quickslot. Ordered steps, each naming a quickslot (fires its whole stack, row 0 first) or one lone skill (owner, 2026-10-21 16:19Z: a single-skill step needs a build guide that recommends it); a macro can therefore cycle more than 4 skills. At most 20 steps (owner, T-106, macro window; generator constant MACRO_MAX_STEPS). A step's quickslot must be one of 'slots'. A skill step names an active skill, never a stigma (stigmas fire from a quickslot's stack). The basic attack (the class's Left click default) may be fired by a macro only as the last skill: as a skill step or inside a stack a step fires (a no-cooldown skill blocks every step above it; claim C21; generator check on the expanded sequence). Each step may carry delayMs, the game's per-step Delay (T-106 screen); any delayMs given is guide advice and needs a cited build-guide page on keyStacks.sources. Guide advice, not a game fact.",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "quickslot",
                  "rows"
                ],
                "properties": {
                  "quickslot": {
                    "description": "The quickslot the macro sits on (Quick Use 2-12; see macros). Never Quick Use 1, left click.",
                    "enum": [
                      "Quick Use 2",
                      "Quick Use 3",
                      "Quick Use 4",
                      "Quick Use 5",
                      "Quick Use 6",
                      "Quick Use 7",
                      "Quick Use 8",
                      "Quick Use 9",
                      "Quick Use 10",
                      "Quick Use 11",
                      "Quick Use 12"
                    ]
                  },
                  "rows": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "minLv",
                        "steps"
                      ],
                      "properties": {
                        "minLv": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "steps": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "properties": {
                              "slot": {
                                "enum": [
                                  "Quick Use 1",
                                  "Quick Use 2",
                                  "Quick Use 3",
                                  "Quick Use 4",
                                  "Quick Use 5",
                                  "Quick Use 6",
                                  "Quick Use 7",
                                  "Quick Use 8",
                                  "Quick Use 9",
                                  "Quick Use 10",
                                  "Quick Use 11",
                                  "Quick Use 12"
                                ]
                              },
                              "skill": {
                                "type": "string",
                                "pattern": "^skill:[a-z]+:[a-z0-9-]+$"
                              },
                              "delayMs": {
                                "description": "The step's Delay in ms (the game's macro window; T-106). Optional; when given it is guide advice and needs a build-guide source. The 10000 maximum is a sanity cap, not a game fact.",
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 10000
                              }
                            },
                            "oneOf": [
                              {
                                "required": [
                                  "slot"
                                ],
                                "type": "object",
                                "properties": {
                                  "slot": true
                                }
                              },
                              {
                                "required": [
                                  "skill"
                                ],
                                "type": "object",
                                "properties": {
                                  "skill": true
                                }
                              }
                            ],
                            "additionalProperties": false
                          },
                          "maxItems": 20
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "eOrder": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^stigma:[a-z]+:[a-z0-9-]+$"
              }
            },
            "eOrderStatus": {
              "description": "The E stack's own label (0.9 P17), when it is less certain than keyStacks.status: the Build drawer tags the E stack with it (\"check in game\" for disputed and owner-check). Absent: no tag of its own.",
              "$ref": "common.schema.json#/$defs/status"
            },
            "defaultKeys": {
              "description": "The game's default keys for the class (0.7 P11): one entry per key in the order the Key setup shows them, each a stack of skills, row 0 first (the row the game tries first). A key with one row is a single key. A row shows from its minLv, else from its skill's learn level. A guide's own recommended setup (slots, macros) stays separate.",
              "type": "object",
              "required": [
                "keys",
                "status",
                "sources"
              ],
              "properties": {
                "keys": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "rows"
                    ],
                    "properties": {
                      "key": {
                        "description": "The key as the game names it: a letter or digit (Q, E, 1), or a mouse button (Left click, Right click).",
                        "type": "string",
                        "pattern": "^([A-Z0-9]|F[0-9]{1,2}|Left click|Right click|Middle click)$"
                      },
                      "rows": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": [
                            "skill"
                          ],
                          "properties": {
                            "skill": {
                              "type": "string",
                              "pattern": "^skill:[a-z]+:[a-z0-9-]+$"
                            },
                            "minLv": {
                              "description": "Character level the row shows from, when it is not the skill's learn level.",
                              "type": "integer",
                              "minimum": 1
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "status": {
                  "$ref": "common.schema.json#/$defs/status"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/sourceRef"
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            },
            "status": {
              "$ref": "common.schema.json#/$defs/status"
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/sourceRef"
              },
              "minItems": 1
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "sources"
          ],
          "additionalProperties": false
        },
        "texts": {
          "description": "Build-specific prose that shared steps pull with [[build:text:<name>]] (e.g. the Nezekan node narrative in g12:0).",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9-]+$",
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/inlineText"
          }
        }
      },
      "unevaluatedProperties": false
    }
  }
}
